# Normalise line endings so the page is identical on every machine
* text=auto eol=lf

# Gradle wrapper must keep its native line endings or it breaks on Windows
gradlew     text eol=lf
*.bat       text eol=crlf

# Binaries — never touch these
*.apk   binary
*.png   binary
*.webp  binary
*.jpg   binary
*.jar   binary
